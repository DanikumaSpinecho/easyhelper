node_modules/
config.json
*.log
.DS_Store

# Notes internes de l'agent (ne jamais publier)
memory/

# Ne jamais versionner d'archives : elles peuvent contenir config.php (mot de passe)
et des données de session
*.zip

# Variante hébergement mutualisé (PHP)
php-full/config.php
php-full/data/*
!php-full/data/.htaccess

# Variante Node.js : configuration locale et journal des connexions
# (dossier local, jamais versionné — il contient des traces d'accès)
vps-node/data/
