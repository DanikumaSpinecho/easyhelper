# easyhelper — hébergement mutualisé (LiteSpeed/Apache)

# HTTPS forcé (ceinture-bretelles : l'hébergeur le fait déjà)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # Sécurité du transport et du contenu
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

  # Pas de cache sur les pages et l'API : le relais doit rester temps réel
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  # Ressources (JS/CSS) : revalidation systématique plutôt que cache long.
  # Un cache de 7 jours servait l'ancien JavaScript après une mise à jour —
  # les boutons ajoutés restaient alors inertes dans les navigateurs déjà
  # venus. La revalidation (ETag) garantit que toute correction est visible
  # au prochain chargement, pour un coût réseau négligeable (304).
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # Expires (7 jours) est posé en amont par l'hébergement : certains
    # intermédiaires s'y fient encore, on le retire pour lever toute ambiguïté.
    Header unset Expires
  </FilesMatch>
</IfModule>

# Ceinture-bretelles : le dossier de données n'est jamais servi
RedirectMatch 403 ^/data/

Options -Indexes
